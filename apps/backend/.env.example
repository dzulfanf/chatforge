# Chatforge backend environment
# Copy to .env and replace the placeholders. Never commit .env.
# Variable names are proposed and will be finalized during the backend phase.

SERVER_PORT=8080

DB_URL=jdbc:postgresql://localhost:5432/chatforge
DB_USERNAME=chatforge
DB_PASSWORD=change-me

# Base64-encoded secret of at least 256 bits, e.g. `openssl rand -base64 32`
JWT_SECRET=<generate-a-random-256-bit-secret>
# Agent token lifetime in seconds
JWT_EXPIRATION=3600
# Visitor token lifetime in seconds
JWT_VISITOR_EXPIRATION=86400

# Comma-separated list of origins allowed to call the API / open WebSocket connections
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
